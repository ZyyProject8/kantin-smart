# Database (Postgres)
DATABASE_URL=postgres://kantin_user:kantin_pass@localhost:5432/kantin_db

# For future Laravel backend, typical .env keys
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=kantin_db
# DB_USERNAME=kantin_user
# DB_PASSWORD=kantin_pass

# ============================================================
# Kantin Pintar - Laravel Backend Configuration
# ============================================================
# Copy file ini ke .env.local atau .env.development lalu isi
# URL backend Laravel (tanpa trailing slash, dengan /api)
VITE_API_URL=http://localhost:8000/api

# Set ke "false" untuk menghubungkan frontend ke Laravel.
# Default "true" agar prototype tetap pakai mock data.
VITE_USE_MOCK_API=true

# Laravel Sanctum CSRF cookie domain (jika pakai Sanctum SPA auth)
VITE_SANCTUM_STATEFUL_DOMAINS=localhost:8000
